{
  "name": "scoder",
  "version": "2.1.0",
  "description": "Sandboxed runner for coding tools using bubblewrap and pasta",
  "type": "module",
  "main": "src/index.ts",
  "bin": {
    "scoder": "./src/index.ts"
  },
  "scripts": {
    "build": "bun build src/index.ts --target bun --compile --outfile dist/scoder",
    "dev": "bun run src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "keywords": ["sandbox", "bubblewrap", "git", "ai"],
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@types/bun": "latest",
    "c8": "^11.0.0",
    "jscpd": "^5.0.7",
    "typescript": "^5.0.0"
  }
}
