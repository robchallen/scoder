# ====== Output helpers ======

error() { echo -e "${RED}${PROGRAM_NAME}: $*${NC}" >&2; }
warning() { echo -e "${YELLOW}${PROGRAM_NAME}: $*${NC}" >&2; }
info() { [[ "${QUIET}" -eq 0 ]] && echo -e "${GREEN}${PROGRAM_NAME}: $*${NC}" >&2 || true; }
info_blue() { [[ "${QUIET}" -eq 0 ]] && echo -e "${BLUE}${PROGRAM_NAME}: $*${NC}" >&2 || true; }

# ====== Usage ======

usage() {
    cat <<'EOF'
scoder 2.0.0
Sandboxed runner for coding tools using bubblewrap.

Usage:
  scoder [options] <tool> [tool-args...]

Supported tools (with built-in presets):
  opencode        OpenCode AI coding assistant
  claude          Claude Code
  copilot         GitHub Copilot CLI

Any other command can be run by name (no preset, generic sandbox).

Options:
  -h, --help              Show this help and exit
  -V, --version           Show version and exit
  -q, --quiet             Suppress informational output
      --validate          Run comprehensive validation tests and exit
      --dry-run           Print the bwrap command without executing

Setup (run once, requires sudo):
  sudo scoder --configure-apparmor
                          Install AppArmor profile to allow bwrap to create
                          user namespaces (required on Ubuntu 24.04+)
  sudo scoder --install-dependencies
                          uses apt to install packages bubblewrap

Git Worktree Lifecycle:
  scoder must be run inside a git repository. On startup it:
    1. Creates a new branch: scoder/<git-repo-name>
    2. Creates a git worktree in /tmp for isolation
    3. Runs the tool inside a bubblewrap sandbox on the worktree
  On exit:
    - Prints a summary of changes made on the branch
    - The worktree and branch are left for you to review
    - Clean up: git worktree remove <path> && git branch -d <branch>

Examples:
  scoder opencode                 # sandbox opencode in $PWD
  scoder claude                   # sandbox claude code
  scoder copilot                  # sandbox GitHub Copilot CLI
  scoder /bin/bash                # generic sandbox with a shell
  scoder --dry-run opencode       # show bwrap command without running

Scoder looks for a .agentreadonly file in the repository root, with a .gitignore syntax
Protected (read-only by default):
  .github/, .opencode/, opencode.json, .claude/, .gitignore, lockfiles (package-lock.json, mise.toml, etc.),

Host tool binds (read-only, when the paths exist):
  ~/R, ~/.Rprofile        R user library and profile (enables R MCP servers)
  ~/.m2                   Java/Maven local repository
  ~/.rustup, ~/.cargo/bin Rust toolchain and binaries
  ~/.local/share/mise,
  ~/.config/mise          mise-en-place tool manager
  ~/.local/bin            User-installed binaries
  ~/.npmrc, ~/.pypirc     Package manager credentials
EOF
}

version() {
    echo "${PROGRAM_NAME} ${PROGRAM_VERSION}"
}

# ====== AppArmor Configuration ======

readonly APPARMOR_PROFILE_PATH="/etc/apparmor.d/bwrap"

configure_apparmor() {
    # Install an AppArmor profile that allows bwrap to create user namespaces.
    # Required on Ubuntu 24.04+ where unprivileged userns is restricted by
    # AppArmor by default (kernel.apparmor_restrict_unprivileged_userns=1).

    if [[ "$(id -u)" -ne 0 ]]; then
        error "--configure-apparmor must be run as root"
        error "Usage: sudo scoder --configure-apparmor"
        exit 1
    fi

    if [[ ! -d /etc/apparmor.d ]]; then
        error "AppArmor does not appear to be installed (/etc/apparmor.d not found)"
        exit 1
    fi

    local bwrap_path
    bwrap_path="$(command -v bwrap 2>/dev/null || true)"
    if [[ -z "${bwrap_path}" ]]; then
        error "bwrap not found in PATH"
        exit 1
    fi
    # Resolve to real path in case of symlinks
    bwrap_path="$(realpath "${bwrap_path}")"

    if [[ -f "${APPARMOR_PROFILE_PATH}" ]]; then
        info "Existing profile found at ${APPARMOR_PROFILE_PATH}:"
        cat "${APPARMOR_PROFILE_PATH}"
        echo ""
    fi

    local profile
    profile="$(cat <<PROFILE_EOF
# AppArmor profile for bubblewrap (bwrap)
# Installed by scoder to allow unprivileged user namespace creation.
# This is required on Ubuntu 24.04+ where AppArmor restricts userns.
# Same approach used by Chrome, Firefox, Flatpak, etc.

abi <abi/4.0>,
include <tunables/global>

profile bwrap ${bwrap_path} flags=(unconfined) {
  userns,

  include if exists <local/bwrap>
}
PROFILE_EOF
)"

    echo "${profile}" > "${APPARMOR_PROFILE_PATH}"
    info "Wrote AppArmor profile to ${APPARMOR_PROFILE_PATH}"

    # Create local override directory (standard AppArmor convention)
    mkdir -p /etc/apparmor.d/local
    if [[ ! -f /etc/apparmor.d/local/bwrap ]]; then
        echo "# Site-specific overrides for bwrap" > /etc/apparmor.d/local/bwrap
    fi

    # Reload the profile
    if command -v apparmor_parser >/dev/null 2>&1; then
        if apparmor_parser -r "${APPARMOR_PROFILE_PATH}" 2>&1; then
            info "AppArmor profile loaded successfully"
        else
            error "Failed to load AppArmor profile"
            error "Try: sudo apparmor_parser -r ${APPARMOR_PROFILE_PATH}"
            exit 1
        fi
    else
        warning "apparmor_parser not found — profile written but not loaded"
        warning "Reload manually or reboot to activate"
    fi

    # Verify it works
    echo ""
    info "Verifying bwrap can create user namespaces..."
    local test_result
    if test_result=$(su -c "bwrap --bind / / /bin/echo SUCCESS" "${SUDO_USER:-nobody}" 2>&1) && [[ "${test_result}" == "SUCCESS" ]]; then
        info "Verification passed — bwrap works for unprivileged users"
    else
        warning "Verification inconclusive: ${test_result}"
        warning "Try running 'scoder --validate' as your normal user"
    fi

    echo ""
    info "Done. You can now run scoder as a normal user."
}

# Check if bwrap is blocked by AppArmor and give actionable advice
check_bwrap_userns() {
    # Quick test: can bwrap create a namespace?
    local test_output
    test_output=$(bwrap --bind / / /bin/true 2>&1) && return 0

    # It failed — diagnose why
    if echo "${test_output}" | grep -q "setting up uid map"; then
        # Check if AppArmor userns restriction is the cause
        local restrict
        restrict=$(sysctl -n kernel.apparmor_restrict_unprivileged_userns 2>/dev/null || echo "0")
        if [[ "${restrict}" -eq 1 ]]; then
            if [[ -f "${APPARMOR_PROFILE_PATH}" ]]; then
                error "bwrap cannot create user namespaces"
                error "An AppArmor profile exists at ${APPARMOR_PROFILE_PATH} but may not be loaded"
                error "Try: sudo apparmor_parser -r ${APPARMOR_PROFILE_PATH}"
            else
                error "bwrap cannot create user namespaces"
                error "AppArmor is restricting unprivileged user namespaces on this system"
                error "Fix: sudo scoder --configure-apparmor"
            fi
            exit 1
        fi
    fi

    # Some other bwrap failure
    error "bwrap self-test failed: ${test_output}"
    exit 1
}

# ======== System dependencies ===========


install_dependencies() {

    if [[ "$(id -u)" -ne 0 ]]; then
        error "--configure-apparmor must be run as root"
        error "Usage: sudo scoder --configure-apparmor"
        exit 1
    fi

    apt install bubblewrap

}


# ====== Tool Presets ======
#
# Each preset defines:
#   config_binds() - function that appends to TOOL_BINDS and TOOL_DIRS arrays
#   validate() - function that checks prerequisites, returns 0/1
#   description - human-readable name

# ====== OpenCode =====

preset_opencode() {
    TOOL_DESCRIPTION="OpenCode"
}

preset_opencode_config_binds() {
    local real_home="${HOME}"
    local sand_home="${SCODER_HOME}"

    # Config: ~/.config/opencode/ (read-only)
    if [[ -d "${real_home}/.config/opencode" ]]; then
        TOOL_DIRS+=("${sand_home}/.config/opencode")
        TOOL_BINDS+=(--ro-bind "${real_home}/.config/opencode" "${sand_home}/.config/opencode")
    fi

    # Data: ~/.local/share/opencode/ (read-write for sessions, db, etc.)
    local data_dir="${real_home}/.local/share/opencode"
    mkdir -p "${data_dir}"
    TOOL_DIRS+=("${sand_home}/.local/share/opencode")
    TOOL_BINDS+=(--bind "${data_dir}" "${sand_home}/.local/share/opencode")

    # Cache: ~/.cache/opencode/ (read-write)
    local cache_dir="${real_home}/.cache/opencode"
    mkdir -p "${cache_dir}"
    TOOL_DIRS+=("${sand_home}/.cache/opencode")
    TOOL_BINDS+=(--bind "${cache_dir}" "${sand_home}/.cache/opencode")
}

preset_opencode_validate() {
    if ! command -v opencode >/dev/null 2>&1; then
        error "opencode not found in PATH"
        error "Install: https://opencode.ai"
        return 1
    fi
    return 0
}

# ====== Claude code =====

preset_claude() {
    TOOL_DESCRIPTION="Claude Code"
}

preset_claude_config_binds() {
    local real_home="${HOME}"
    local sand_home="${SCODER_HOME}"

    # Config: ~/.claude/ (read-only)
    if [[ -d "${real_home}/.claude" ]]; then
        TOOL_DIRS+=("${sand_home}/.claude")
        TOOL_BINDS+=(--ro-bind "${real_home}/.claude" "${sand_home}/.claude")
    else
        warning "Claude config not found at ~/.claude/"
        warning "Run 'claude' once first to initialize"
    fi

    # Claude also uses ~/.config/claude/ on some setups
    if [[ -d "${real_home}/.config/claude" ]]; then
        TOOL_DIRS+=("${sand_home}/.config/claude")
        TOOL_BINDS+=(--ro-bind "${real_home}/.config/claude" "${sand_home}/.config/claude")
    fi
}

preset_claude_validate() {
    if ! command -v claude >/dev/null 2>&1; then
        error "claude not found in PATH"
        error "Install: npm install -g @anthropic-ai/claude-code"
        return 1
    fi
    # Check node is available (claude code needs it)
    if ! command -v node >/dev/null 2>&1; then
        error "node not found in PATH (required by Claude Code)"
        return 1
    fi
    return 0
}


# ====== Copilot =====

preset_copilot() {
    TOOL_DESCRIPTION="GitHub Copilot CLI"
}

preset_copilot_config_binds() {
    local real_home="${HOME}"
    local sand_home="${SCODER_HOME}"

    # Copilot CLI can authenticate via ~/.config/gh/ (GH_TOKEN / hosts.yml)
    if [[ -d "${real_home}/.config/gh" ]]; then
        TOOL_DIRS+=("${sand_home}/.config/gh")
        TOOL_BINDS+=(--ro-bind "${real_home}/.config/gh" "${sand_home}/.config/gh")
    else
        warning "gh config not found at ~/.config/gh/"
        warning "Run 'gh auth login' first to authenticate"
    fi

    # Copilot CLI's own config directory
    if [[ -d "${real_home}/.config/github-copilot" ]]; then
        TOOL_DIRS+=("${sand_home}/.config/github-copilot")
        TOOL_BINDS+=(--bind "${real_home}/.config/github-copilot" "${sand_home}/.config/github-copilot")
    fi

    # Copilot CLI's own config directory writeable for session state
    if [[ -d "${real_home}/.copilot" ]]; then
        TOOL_DIRS+=("${sand_home}/.copilot")
        TOOL_BINDS+=(--bind "${real_home}/.copilot" "${sand_home}/.copilot")
    fi

    # Copilot CLI's own config directory writeable for session state
    if [[ -d "${real_home}/.cache/copilot" ]]; then
        TOOL_DIRS+=("${sand_home}.cache/copilot")
        TOOL_BINDS+=(--bind "${real_home}/.cache/copilot" "${sand_home}/.cache/copilot")
    fi

    # Copilot CLI stores session data / memories
    local data_dir="${real_home}/.local/share/github-copilot"
    mkdir -p "${data_dir}"
    TOOL_DIRS+=("${sand_home}/.local/share/github-copilot")
    TOOL_BINDS+=(--bind "${data_dir}" "${sand_home}/.local/share/github-copilot")
}

preset_copilot_validate() {
    if ! command -v copilot >/dev/null 2>&1; then
        error "copilot not found in PATH"
        error "Install: npm install -g @github/copilot"
        error "    or:  brew install copilot-cli"
        return 1
    fi
    if ! command -v node >/dev/null 2>&1; then
        error "node not found in PATH (required by Copilot CLI)"
        return 1
    fi
    return 0
}

# ====== Git Worktree Lifecycle ======

WORKTREE_DIR=""
WORKTREE_BRANCH=""
WORKTREE_BASE_COMMIT=""
GIT_DIR=""
# ORIG_DIR=""
PROJ_DIR=""

setup_git_worktree() {
    # ORIG_DIR="${PWD}"


    # Verify we are in a git repo
    if ! git rev-parse --git-dir >/dev/null 2>&1; then
        error "not inside a git repository"
        error "scoder must be run from within a git repo"
        exit 1
    fi

    GIT_DIR="$(git rev-parse --absolute-git-dir)"
    local repo_root
    repo_root="$(git rev-parse --show-toplevel)"
    proj_name="$(basename "${repo_root}")"
    PROJ_DIR="$(realpath -m --relative-to="${HOME}" "${repo_root}")"

    # Check for uncommitted changes — warn but don't block
    if ! git diff-index --quiet HEAD -- 2>/dev/null; then
        error "You have uncommitted changes in your working tree"
        error "You must commit (or stash) them before running scoder"
        exit 1
    fi

    # Generate branch name: scoder/<tool>/<date>-<random>
    # local date_str
    # date_str="$(date +%Y-%m-%d)"
    # local rand_id
    # rand_id="$(head -c 4 /dev/urandom | od -An -tx1 | tr -d ' \n')"
    # local tool_label
    # tool_label="$(basename "${TOOL_NAME}")"
    # WORKTREE_BRANCH="scoder/${tool_label}/${date_str}-${rand_id}"

    # Generate branch name: scoder/<git-proj-name>
    WORKTREE_BRANCH="scoder/${proj_name}"

    if ! git branch | grep "$WORKTREE_BRANCH" >/dev/null; then
        # There is no branch named scoder/${proj_name}

        WORKTREE_DIR="/tmp/scoder/${PROJ_DIR}"
        info "Creating worktree branch: ${WORKTREE_BRANCH}"
        info "Worktree path: ${WORKTREE_DIR}"

        local wt_output
        if ! wt_output=$(git worktree add -b "${WORKTREE_BRANCH}" "${WORKTREE_DIR}" HEAD 2>&1); then
            error "Failed to create git worktree"
            error "${wt_output}"
            exit 1
        fi

        info "Worktree created successfully"

    fi

    if git worktree list --porcelain | grep  "^branch refs/heads/$WORKTREE_BRANCH" >/dev/null; then

        # It is a worktree: read the current directory associated with it.
        WORKTREE_DIR="$(git worktree list --porcelain | grep -B2 "^branch refs/heads/$WORKTREE_BRANCH" | head -1 | cut -d' ' -f 2)"

    fi

    if [ -z "$WORKTREE_DIR" ]; then
        error "Branch $WORKTREE_BRANCH exists but is not a git worktree - you'll need to manually review it."
        info "to review:   git diff main..$WORKTREE_BRANCH"
        info "to delete:   git branch -D $WORKTREE_BRANCH"
        exit 1
    fi

    # If a stale worktree with no files are listed then
    if git worktree list --porcelain | grep -A1 "^branch refs/heads/$WORKTREE_BRANCH" | tail -1 | grep "prunable" >/dev/null; then
        # pruneable
        git worktree prune
        error "Branch $WORKTREE_BRANCH exists but the worktree has gone - you need to manually review it."
        info "to review:   git diff main..$WORKTREE_BRANCH"
        info "to delete:   git branch -D $WORKTREE_BRANCH"
        exit 1
    fi


    # Create worktree directory
    # WORKTREE_DIR="/tmp/scoder-wt-${rand_id}"

    # Record the base commit so we can compare against it later in the summary
    WORKTREE_BASE_COMMIT="$(git rev-parse HEAD)"

}

cleanup_worktree_summary() {
    # Called on exit — print summary of what happened on the branch
    # Disable errexit so cleanup always completes
    set +e
    local exit_code=$?

    # reset

    # If worktree was never created, nothing to summarize
    if [[ -z "${WORKTREE_DIR}" || ! -d "${WORKTREE_DIR}" ]]; then
        return "${exit_code}"
    fi

    info "${TOOL_DESCRIPTION} session complete."

    git -C "${WORKTREE_DIR}" add -A
    git -C "${WORKTREE_DIR}" commit -m "Committing session by ${TOOL_DESCRIPTION}."

    echo "" >&2
    info_blue "====== Session Summary ======"

    info_blue "Branch: ${WORKTREE_BRANCH}"
    info_blue "Worktree: ${WORKTREE_DIR}"

    # Count commits on the branch since it was created
    local commit_count=0
    if [[ -n "${WORKTREE_BASE_COMMIT}" ]]; then
        commit_count=$(git -C "${WORKTREE_DIR}" rev-list "${WORKTREE_BASE_COMMIT}..HEAD" --count 2>/dev/null || echo "0")
    fi

    if [[ "${commit_count}" -gt 0 ]]; then
        info_blue "New commits: ${commit_count}"
        # Show overall diff stat from base to branch tip
        local stat_output
        stat_output=$(git -C "${WORKTREE_DIR}" diff --stat "${WORKTREE_BASE_COMMIT}" HEAD 2>/dev/null || true)
        if [[ -n "${stat_output}" ]]; then
            info_blue "Changes since base:"
            echo "${stat_output}" | while read -r line; do
                info_blue "  ${line}"
            done
        fi
    fi

    if [[ "${commit_count}" -eq 0 ]]; then
        info_blue "No changes were made"
    fi

    echo "" >&2
    info "To review:  git log ${WORKTREE_BRANCH}"
    info "To merge:   git merge ${WORKTREE_BRANCH}"
    info "To rebase:  git rebase main ${WORKTREE_BRANCH}"
    info "View diff:  git diff main..${WORKTREE_BRANCH}"
    info "To discard: git worktree remove ${WORKTREE_DIR} && git branch -D ${WORKTREE_BRANCH}"

    return "${exit_code}"
}

# ====== Defaults ======

QUIET=0
VALIDATE_MODE=0
CONFIGURE_APPARMOR=0
INSTALL_DEPENDENCIES=0
DRY_RUN=0
# RESTRICT_DEV=0

TOOL_NAME=""
TOOL_ARGS=()

# ====== Option Parsing ======
# Parse scoder options until we hit a non-option (the tool name)

while [[ $# -gt 0 ]]; do
    case "$1" in
    -h | --help)
        usage
        exit 0
        ;;
    -V | --version)
        version
        exit 0
        ;;
    -q | --quiet)
        QUIET=1
        shift
        ;;
    --validate)
        VALIDATE_MODE=1
        shift
        ;;
    --configure-apparmor)
        CONFIGURE_APPARMOR=1
        shift
        ;;
    --install-dependencies)
        INSTALL_DEPENDENCIES=1
        shift
        ;;
    --dry-run)
        DRY_RUN=1
        shift
        ;;
    -*)
        error "unknown option: $1"
        echo "Try '${PROGRAM_NAME} --help' for more information." >&2
        exit 1
        ;;
    *)
        # First non-option is the tool name; rest are tool args
        TOOL_NAME="$1"
        shift
        TOOL_ARGS=("$@")
        break
        ;;
    esac
done

# ====== Validation (early) ======

if [[ "${INSTALL_DEPENDENCIES}" -eq 1 ]]; then
    install_dependencies
    exit $?
fi

if ! command -v bwrap >/dev/null 2>&1; then
    error "bubblewrap (bwrap) not found in PATH"
    error "run sudo scoder --install-dependencies"
    exit 1
fi

# ====== AppArmor setup (early exit) ======

if [[ "${CONFIGURE_APPARMOR}" -eq 1 ]]; then
    configure_apparmor
    exit $?
fi

# ====== Check bwrap can actually work ======

check_bwrap_userns

# ====== Validation tests ======

run_validation() {
    local script_path
    script_path="$(realpath "$0")"
    local test_base="/tmp/scoder-validation-$$"
    local test_repo="${test_base}/repo"
    local failed=0
    local passed=0

    info "====== scoder validation tests ======"

    # Set up a test git repo
    mkdir -p "${test_repo}"
    git -C "${test_repo}" init -q
    git -C "${test_repo}" config user.email "test@scoder"
    git -C "${test_repo}" config user.name "scoder-test"
    echo "test" > "${test_repo}/file.txt"
    mkdir -p "${test_repo}/.github"
    echo "workflow" > "${test_repo}/.github/ci.yml"
    echo "*.pyc" > "${test_repo}/.gitignore"
    echo "{}" > "${test_repo}/package-lock.json"
    git -C "${test_repo}" add -A
    git -C "${test_repo}" commit -q -m "initial"

    run_test() {
        local name="$1"
        local result="$2"
        local expected="$3"

        if echo "${result}" | grep -qE "${expected}"; then
            echo "  PASS: ${name}"
            passed=$((passed + 1))
        else
            echo "  FAIL: ${name}"
            echo "    Expected pattern: ${expected}"
            echo "    Got: ${result}"
            failed=$((failed + 1))
        fi
    }

    # Helper: run scoder from within the test repo
    run_scoder() {
        (cd "${test_repo}" && "${script_path}" "$@" 2>&1) || true
    }

    # Test 1: HOME isolation
    echo ""
    info "Test 1: HOME isolation"
    local t1
    t1=$(run_scoder -q /bin/bash -c 'echo $HOME')
    run_test "HOME is ${SCODER_HOME}" "${t1}" "${SCODER_HOME}"

    # Test 2: System files read-only
    info "Test 2: System file protection"
    local t2
    t2=$(run_scoder -q /bin/bash -c 'touch /usr/bin/scoder-test 2>&1')
    run_test "Cannot write to /usr" "${t2}" "Read-only|Permission denied|cannot touch"

    # Test 3: Worktree is writable (default --rw)
    info "Test 3: Worktree writability"
    local t3
    t3=$(run_scoder -q /bin/bash -c 'touch newfile.txt && echo SUCCESS')
    run_test "Worktree writable" "${t3}" "SUCCESS"

    # Test 4: .github protection (default)
    info "Test 4: .github directory protection"
    local t4
    t4=$(run_scoder -q /bin/bash -c 'touch .github/test 2>&1')
    run_test ".github is read-only" "${t4}" "Read-only|Permission denied|cannot touch"

    # Test 5: .gitignore protection
    info "Test 5: .gitignore file protection"
    local t5
    t5=$(run_scoder -q /bin/bash -c 'echo "test" >> .gitignore 2>&1')
    run_test ".gitignore is read-only" "${t5}" "Read-only|Permission denied|cannot"

    # Test 6:
    # an empty .agentreadonly allows all directories writable, so we test by writing a temp
    # file in the .github dir.
    info "Test 6: allow github access with empty .agentreadonly"
    touch "${test_repo}/.agentreadonly"
    local t6
    t6=$(run_scoder -q /bin/bash -c 'touch .github/test && echo SUCCESS')
    run_test "empty .agentreadonly makes .github dir writable" "${t6}" "SUCCESS"

    # Test 6:
    # an empty .agentreadonly allows all directories writable, so we test by writing a temp
    # file in the .github dir.
    info "Test 7: allow github access with empty .agentreadonly"
    local t7
    t7=$(run_scoder -q /bin/bash -c -c 'echo "test" >> .agentreadonly 2>&1')
    run_test ".agentreadonly is read-only" "${t7}" "Read-only|Permission denied|cannot"

    # Test 8: Git worktree was created (branch exists)
    info "Test 8: Worktree branch creation"
    local branches
    branches=$(git -C "${test_repo}" branch --list 'scoder/*' 2>/dev/null || true)
    if [[ -n "${branches}" ]]; then
        echo "  PASS: Worktree branch(es) created"
        passed=$((passed + 1))
    else
        echo "  FAIL: No scoder/* branches found"
        failed=$((failed + 1))
    fi

    # Cleanup: remove worktrees and branches
    for wt in $(git -C "${test_repo}" worktree list --porcelain 2>/dev/null | grep "^worktree /tmp/scoder" | cut -d' ' -f2); do
        git -C "${test_repo}" worktree remove --force "${wt}" 2>/dev/null || true
    done
    for br in $(git -C "${test_repo}" branch --list 'scoder/*' 2>/dev/null | tr -d ' *'); do
        git -C "${test_repo}" branch -D "${br}" 2>/dev/null || true
    done
    rm -rf "${test_base}"

    echo ""
    if [[ "${failed}" -eq 0 ]]; then
        info "All ${passed} tests passed"
        return 0
    else
        error "${failed} test(s) failed, ${passed} passed"
        return 1
    fi
}

if [[ "${VALIDATE_MODE}" -eq 1 ]]; then
    # For validation, we run tests from the test repo dir
    # The tests themselves invoke scoder with /bin/bash
    run_validation
    exit $?
fi

# ====== Tool name required ======

if [[ -z "${TOOL_NAME}" ]]; then
    error "no tool specified"
    echo "Usage: ${PROGRAM_NAME} [options] <tool> [tool-args...]" >&2
    echo "Try '${PROGRAM_NAME} --help' for more information." >&2
    exit 1
fi

# ====== Apply tool preset ======

TOOL_DESCRIPTION=""
TOOL_BINDS=()
TOOL_DIRS=()
HAS_PRESET=0

case "${TOOL_NAME}" in
opencode)
    HAS_PRESET=1
    preset_opencode
    ;;
claude)
    HAS_PRESET=1
    preset_claude
    ;;
copilot)
    HAS_PRESET=1
    preset_copilot
    ;;
*)
    # No preset — generic sandbox
    TOOL_DESCRIPTION="${TOOL_NAME}"
    ;;
esac

# Resolve tool binary
TOOL_BIN=""
if command -v "${TOOL_NAME}" >/dev/null 2>&1; then
    TOOL_BIN="$(command -v "${TOOL_NAME}")"
else
    error "${TOOL_NAME} not found in PATH"
    exit 1
fi

# Run preset validation if available
if [[ "${HAS_PRESET}" -eq 1 ]]; then
    if ! "preset_${TOOL_NAME}_validate"; then
        exit 1
    fi
fi

# ====== Git worktree setup ======

setup_git_worktree

# Register cleanup on exit (and common signals for reliable cleanup)
trap cleanup_worktree_summary EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

# ====== Build tool-specific config binds ======

if [[ "${HAS_PRESET}" -eq 1 ]]; then
    "preset_${TOOL_NAME}_config_binds"
fi

# ====== Resolve paths ======

# GIT_DIR was already set in setup_git_worktree() — reuse it
WORKTREE_DIR_REAL="$(realpath "${WORKTREE_DIR}")"
SCODER_PROJ_DIR="$SCODER_HOME/$PROJ_DIR"

# ====== Build sandbox PATH ======

SANDBOX_PATH="/usr/local/bin:/usr/local/sbin:/usr/bin:/usr/sbin:/bin:/sbin"
EXTRA_BINDS=()

# Host tools

if [[ -d "${HOME}/.local/bin" ]]; then
    EXTRA_BINDS+=(--ro-bind "${HOME}/.local/bin" "${SCODER_HOME}/.local/bin")
    SANDBOX_PATH="${SANDBOX_PATH}:${SCODER_HOME}/.local/bin"
fi

# R
[[ -d "${HOME}/R" ]] && EXTRA_BINDS+=(--ro-bind "${HOME}/R" "${SCODER_HOME}/R")
[[ -e "${HOME}/.Rprofile" ]] && EXTRA_BINDS+=(--ro-bind "${HOME}/.Rprofile" "${SCODER_HOME}/.Rprofile")

# Java
[[ -d "${HOME}/.m2" ]] && EXTRA_BINDS+=(--ro-bind "${HOME}/.m2" "${SCODER_HOME}/.m2")

# Mise
[[ -d "${HOME}/.local/share/mise" ]] && EXTRA_BINDS+=(--ro-bind "${HOME}/.local/share/mise" "${SCODER_HOME}/.local/share/mise")
[[ -d "${HOME}/.config/mise" ]] && EXTRA_BINDS+=(--ro-bind "${HOME}/.config/mise" "${SCODER_HOME}/.config/mise")
[[ -d "${HOME}/.local/share/mise/shims" ]] && SANDBOX_PATH="${SANDBOX_PATH}:${SCODER_HOME}/.local/share/mise/shims"

# Rust
[[ -d "${HOME}/.rustup" ]] && EXTRA_BINDS+=(--ro-bind "${HOME}/.rustup" "${SCODER_HOME}/.rustup")
if [[ -d "${HOME}/.cargo/bin" ]]; then
    EXTRA_BINDS+=(--ro-bind "${HOME}/.cargo/bin" "${SCODER_HOME}/.cargo/bin")
    SANDBOX_PATH="${SANDBOX_PATH}:${SCODER_HOME}/.cargo/bin"
fi

# Config files
[[ -f "${HOME}/.npmrc" ]] && EXTRA_BINDS+=(--ro-bind "${HOME}/.npmrc" "${SCODER_HOME}/.npmrc")
[[ -f "${HOME}/.pypirc" ]] && EXTRA_BINDS+=(--ro-bind "${HOME}/.pypirc" "${SCODER_HOME}/.pypirc")


# Worktree-local tool paths
if [[ -d "${WORKTREE_DIR_REAL}/.venv/bin" ]]; then
    SANDBOX_PATH="${SCODER_PROJ_DIR}/.venv/bin:${SANDBOX_PATH}"
fi
if [[ -d "${WORKTREE_DIR_REAL}/node_modules/.bin" ]]; then
    SANDBOX_PATH="${SCODER_PROJ_DIR}/node_modules/.bin:${SANDBOX_PATH}"
fi
if [[ -d "${WORKTREE_DIR_REAL}/bin" && -f "${WORKTREE_DIR_REAL}/go.mod" ]]; then
    SANDBOX_PATH="${SCODER_PROJ_DIR}/bin:${SANDBOX_PATH}"
fi

# ====== Infrastructure Protection ======

# Defaults:
PROTECTED=(".github/" ".opencode/" ".claude/" "opencode.json" ".gitignore" "package-lock.json" "poetry.lock" "Cargo.lock" "pnpm-lock.yaml" "yarn.lock" "mise.toml")
if [[ -e "${WORKTREE_DIR_REAL}/.agentreadonly" ]]; then
    # 2. Expand patterns correctly
    # We use 'cd' inside the subshell so find's %P output is relative to that root.
    readarray -t PROTECTED < <(
        grep -vE '^\s*(#|$)' "${WORKTREE_DIR_REAL}/.agentreadonly" | while read -r line; do
            # 1. Clean trailing slash from pattern
            pattern="${line%/}"

            # 2. Run find from within the directory
            # Using "." as the search path and then filtering makes it robust
            (cd "$WORKTREE_DIR_REAL" && eval "find \"$pattern\" -maxdepth 100 -prune 2>/dev/null")
        done | sed 's|^\./||' | sort -u
    )
else
    printf "%s\n" "${PROTECTED[@]}" > "${WORKTREE_DIR_REAL}/.agentreadonly"
fi

SAFE_BINDS=()
SAFE_BINDS+=(--ro-bind "${WORKTREE_DIR_REAL}/.agentreadonly" "${SCODER_PROJ_DIR}/.agentreadonly")

# 3. Apply the binds
for path in "${PROTECTED[@]}"; do
    # Skip empty lines if any
    path="${path%/}"
    [[ -z "$path" ]] && continue

    src="${WORKTREE_DIR_REAL}/${path}"
    dest="${SCODER_PROJ_DIR}/${path}"

    if [[ -e "$src" ]]; then
        SAFE_BINDS+=(--ro-bind "$src" "$dest")
        info "Protecting ${path} (read-only)"
    fi
done

# ====== Build bwrap command ======

BWRAP_CMD=(
    bwrap
    # System mounts (read-only)
    --ro-bind /usr /usr
    --ro-bind /bin /bin
    --ro-bind /lib /lib
)

[[ -d /lib64 ]] && BWRAP_CMD+=(--ro-bind /lib64 /lib64)
[[ -d /sbin && ! -L /sbin ]] && BWRAP_CMD+=(--ro-bind /sbin /sbin)
[[ -d /sys ]] && BWRAP_CMD+=(--ro-bind /sys /sys)
[[ -d /run ]] && BWRAP_CMD+=(--ro-bind /run /run)

BWRAP_CMD+=(--ro-bind /etc /etc)

# Device access
# if [[ "${RESTRICT_DEV}" -eq 1 ]]; then
BWRAP_CMD+=(
#     --dev-bind /dev/null /dev/null
#     --dev-bind /dev/zero /dev/zero
#     --dev-bind /dev/random /dev/random
#     --dev-bind /dev/urandom /dev/urandom
#     --dev-bind /dev/tty /dev/tty
#     --dev-bind /dev/ptmx /dev/ptmx
#     --dev-bind /dev/pts /dev/pts
#     --dev-bind /dev/fd /dev/fd
    --dev-bind /dev /dev
    --tmpfs /dev/shm
)
# else
#    BWRAP_CMD+=(--dev /dev)
# fi

BWRAP_CMD+=(
    --proc /proc
    --tmpfs /tmp

    # Ephemeral HOME
    --tmpfs /home
    --dir "${SCODER_HOME}"
    --dir "${SCODER_HOME}/.local"
    --dir "${SCODER_HOME}/.local/share"
    --dir "${SCODER_HOME}/.config"
    --dir "${SCODER_HOME}/.cache"
    --dir "${SCODER_PROJ_DIR}"
)

# Create any extra dirs needed by tool presets
for d in "${TOOL_DIRS[@]}"; do
    BWRAP_CMD+=(--dir "${d}")
done

# Tool-specific config binds
if [[ ${#TOOL_BINDS[@]} -gt 0 ]]; then
    BWRAP_CMD+=("${TOOL_BINDS[@]}")
fi

# Host tools
if [[ ${#EXTRA_BINDS[@]} -gt 0 ]]; then
    BWRAP_CMD+=("${EXTRA_BINDS[@]}")
fi

# Worktree directory (at its real path)
BWRAP_CMD+=(--bind "${WORKTREE_DIR_REAL}" "${SCODER_PROJ_DIR}")

# Protected infra overlays (must come AFTER the worktree bind to overlay)
if [[ ${#SAFE_BINDS[@]} -gt 0 ]]; then
    BWRAP_CMD+=("${SAFE_BINDS[@]}")
fi

# Git directory: the worktree's .git file points to GIT_DIR/worktrees/<name>
# which in turn references back. Both must be accessible at real paths.
# The worktree must be able to write to it to persist changes back to the branch
BWRAP_CMD+=(--bind "${GIT_DIR}" "${GIT_DIR}")

# Working directory
BWRAP_CMD+=(--chdir "${SCODER_PROJ_DIR}")

# Isolation + environment
BWRAP_CMD+=(
    --new-session
    --die-with-parent
    --clearenv
    --setenv PATH "${SANDBOX_PATH}"
    --setenv HOME "${SCODER_HOME}"
    --setenv USER scoder
    --setenv LOGNAME scoder
    --setenv TERM "${TERM:-xterm-256color}"
    --setenv LANG "${LANG:-C.UTF-8}"
)

# Pass through common env vars tools may need
# Maybe these: https://opencode.ai/docs/cli/#environment-variables
# and these: https://code.claude.com/docs/en/env-vars
# and these: https://git-scm.com/book/en/v2/Git-Internals-Environment-Variables
# maybe these: https://cli.github.com/manual/gh_help_environment
# ones that change the config directories are going to be super hard and maybe we shoudl be picking up
# at the bind stage.
#
# COPILOT_HOME?

PASS=("EDITOR" "VISUAL" "NO_COLOR" "FORCE_COLOR" "OPENROUTER_API_KEY" "ANTHROPIC_BASE_URL" "ANTHROPIC_AUTH_TOKEN"
"ANTHROPIC_API_KEY")
for v in "${PASS[@]}"; do
    if [[ -v "$v" && -n "${!v}" ]]; then
        BWRAP_CMD+=(--setenv "${v}" "${!v}")
    fi
done

# [[ -n "${EDITOR:-}" ]] && BWRAP_CMD+=(--setenv EDITOR "${EDITOR}")
# [[ -n "${VISUAL:-}" ]] && BWRAP_CMD+=(--setenv VISUAL "${VISUAL}")
# [[ -n "${NO_COLOR:-}" ]] && BWRAP_CMD+=(--setenv NO_COLOR "${NO_COLOR}")
# [[ -n "${FORCE_COLOR:-}" ]] && BWRAP_CMD+=(--setenv FORCE_COLOR "${FORCE_COLOR}")

# GIT_WORK_TREE is intentionally NOT set — the worktree's .git file
# already tells git where to find the repository. Setting GIT_WORK_TREE
# would override the worktree detection and break things.

# Tool binary + args
BWRAP_CMD+=("${TOOL_BIN}")
if [[ ${#TOOL_ARGS[@]} -gt 0 ]]; then
    BWRAP_CMD+=("${TOOL_ARGS[@]}")
fi

# ====== Execute ======

if [[ "${DRY_RUN}" -eq 1 ]]; then
    info "Dry run — would execute:"
    echo ""
    # Print command in a readable format
    printf '%q' "${BWRAP_CMD[0]}"
    for arg in "${BWRAP_CMD[@]:1}"; do
        if [[ "${arg}" == --* ]]; then
            printf ' \\\n  %q' "${arg}"
        else
            printf ' %q' "${arg}"
        fi
    done
    echo ""
    exit 0
fi



if [[ -n "${TOOL_DESCRIPTION}" ]]; then
    info "Launching ${TOOL_DESCRIPTION} in sandbox..."
else
    info "Launching ${TOOL_NAME} in sandbox..."
fi
info "Agent working files can be found at:   ${WORKTREE_DIR_REAL}"
info "and interim commits viewed with:       git diff main..${WORKTREE_BRANCH}"

"${BWRAP_CMD[@]}"
