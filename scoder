    # Copilot CLI's own config directory writeable for session state
    if [[ -d "${real_home}/.copilot" ]]; then
        TOOL_DIRS+=("${sand_home}/.copilot")
        TOOL_BINDS+=(--bind "${real_home}/.copilot" "${sand_home}/.copilot")
    fi

    # Copilot CLI's own config directory writeable for session state
    if [[ -d "${real_home}/.cache/copilot" ]]; then
        TOOL_DIRS+=("${sand_home}.cache/copilot")
        TOOL_BINDS+=(--bind "${real_home}/.cache/copilot" "${sand_home}/.cache/copilot")
