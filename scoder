"XIAOMI_API_KEY"
# Pi Coding Agent cloud provider settings
"AZURE_OPENAI_BASE_URL" "AZURE_OPENAI_RESOURCE_NAME" "AZURE_OPENAI_API_VERSION" "AZURE_OPENAI_DEPLOYMENT_NAME_MAP"
"AWS_PROFILE" "AWS_ACCESS_KEY_ID" "AWS_SECRET_ACCESS_KEY" "AWS_BEARER_TOKEN_BEDROCK" "AWS_REGION"
"GOOGLE_CLOUD_PROJECT" "GOOGLE_CLOUD_LOCATION" "GOOGLE_APPLICATION_CREDENTIALS"
# Pi Coding Agent specific
"PI_SKIP_VERSION_CHECK" "PI_OFFLINE"
)
for v in "${PASS[@]}"; do
    if [[ -v "$v" && -n "${!v}" ]]; then
        BWRAP_CMD+=(--setenv "${v}" "${!v}")
    fi
done

# GIT_WORK_TREE is intentionally NOT set — the worktree's .git file
# already tells git where to find the repository. Setting GIT_WORK_TREE
# would override the worktree detection and break things.

# Tool binary + args via pasta-managed network namespace
BWRAP_CMD+=(
    pasta
    --quiet
    --foreground
    --config-net
    --dhcp-dns
    --no-map-gw
    --tcp-ports none
    --udp-ports none
)

# Handle LLM port forwarding - support comma-separated list of ports
if [[ -n "${LLM_PORT}" ]]; then
    # Split by comma and add each port with --tcp-ns
    IFS=',' read -ra PORTS <<< "${LLM_PORT}"
    for port in "${PORTS[@]}"; do
        BWRAP_CMD+=(--tcp-ns "${port}")
    done
else
    # Default behavior - block all TCP ports
    BWRAP_CMD+=(--tcp-ns none)
fi
BWRAP_CMD+=(
    --udp-ns none
    --
    "${TOOL_BIN}"
)
if [[ ${#TOOL_ARGS[@]} -gt 0 ]]; then
    BWRAP_CMD+=("${TOOL_ARGS[@]}")
fi

# ====== Execute ======

if [[ "${DRY_RUN}" -eq 1 ]]; then
    info "Dry run — would execute:"
    echo ""
    # Print command in a readable format
    printf '%q' "${BWRAP_CMD[0]}"
    for arg in "${BWRAP_CMD[@]:1}"; do
        if [[ "${arg}" == --* ]]; then
            printf ' \\\n  %q' "${arg}"
        else
            printf ' %q' "${arg}"
        fi
    done
    echo ""
    exit 0
fi



if [[ -n "${TOOL_DESCRIPTION}" ]]; then
    info "Launching ${TOOL_DESCRIPTION} in sandbox..."
else
    info "Launching ${TOOL_NAME} in sandbox..."
fi
info "Agent working files can be found at:   ${WORKTREE_DIR_REAL}"
info "and interim commits viewed with:       git diff ${WORKTREE_BRANCH}"

"${BWRAP_CMD[@]}"
