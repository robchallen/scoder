#!/usr/bin/env bash

# scoder - Sandboxed runner for coding tools using bubblewrap and pasta
# Supports: opencode, claude, copilot (and arbitrary commands via generic sandbox)
# License: MIT

set -euo pipefail

readonly PROGRAM_NAME="scoder"
readonly PROGRAM_VERSION="2.0.0"

# Colors for output
readonly RED='\033[0;31m'
readonly YELLOW='\033[1;33m'
readonly GREEN='\033[0;32m'
readonly BLUE='\033[0;34m'
readonly NC='\033[0m'

readonly SCODER_HOME='/home/scoder'

# ====== Output helpers ======

error() { echo -e "${RED}${PROGRAM_NAME}: $*${NC}" >&2; }
warning() { echo -e "${YELLOW}${PROGRAM_NAME}: $*${NC}" >&2; }
info() {
    if [[ "${QUIET}" -eq 0 ]]; then
        echo -e "${GREEN}${PROGRAM_NAME}: $*${NC}" >&2
    fi
}
info_blue() {
    if [[ "${QUIET}" -eq 0 ]]; then
        echo -e "${BLUE}${PROGRAM_NAME}: $*${NC}" >&2
    fi
}

# ====== Usage ======

usage() {
    cat <<'EOF'
scoder 2.0.0
Sandboxed runner for coding tools using bubblewrap and pasta.

Usage:
  scoder [options] <tool> [tool-args...]

Supported tools (with built-in presets):
   opencode        OpenCode AI coding assistant
   claude          Claude Code
   copilot         GitHub Copilot CLI
   pi              Pi Coding Agent

Any other command can be run by name (no preset, generic sandbox).

Options:
   -h, --help              Show this help and exit
   -V, --version           Show version and exit
   -q, --quiet             Suppress informational output
       --llm-port PORTS    Allow localhost TCP access to these comma-separated ports
                            instead of the auto-detected default on 11434
       --dry-run           Print the bwrap command without executing

Setup (run once, requires sudo):
  sudo scoder --configure-apparmor
                          Install AppArmor profile to allow bwrap to create
                          user namespaces (required on Ubuntu 24.04+)
  sudo scoder --install-dependencies
                          uses apt to install packages bubblewrap, passt

Git Worktree Lifecycle:
  scoder must be run inside a git repository. On startup it:
    1. Creates a new branch: scoder/<git-repo-name>
    2. Creates a git worktree in /tmp for isolation
    3. Runs the tool inside a bubblewrap sandbox on the worktree
       with a pasta-managed network namespace blocking host localhost access
  On exit:
    - Prints a summary of changes made on the branch
    - The worktree and branch are left for you to review
    - Clean up: git worktree remove <path> && git branch -d <branch>

Examples:
  scoder opencode                 # sandbox opencode in $PWD
  scoder claude                   # sandbox claude code
  scoder copilot                  # sandbox GitHub Copilot CLI
  scoder /bin/bash                # generic sandbox with a shell
  scoder --llm-port=11434 claude  # allow access to local Ollama
  scoder --dry-run opencode       # show bwrap command without running

Scoder looks for a .agentreadonly file in the repository root.
Repo-relative entries are expanded like workspace protection patterns.
Bare \$HOME/... entries bind existing home directories read-only into the sandbox
at matching /home/scoder/... paths.
Protected (read-only by default):
  .github/, opencode.json, .claude/, .gitignore, lockfiles (package-lock.json, mise.toml, etc.),

Host tool binds (read-only, when the paths exist):
  ~/R, ~/.Rprofile        R user library and profile (enables R MCP servers)
  ~/.m2                   Java/Maven local repository
  ~/.rustup, ~/.cargo/bin Rust toolchain and binaries
  ~/.local/share/mise,
  ~/.config/mise          mise-en-place tool manager
  ~/.local/bin            User-installed binaries
  ~/.npmrc, ~/.pypirc     Package manager credentials
EOF
}

version() {
    echo "${PROGRAM_NAME} ${PROGRAM_VERSION}"
}

# ====== AppArmor Configuration ======

readonly APPARMOR_PROFILE_PATH="/etc/apparmor.d/bwrap"

configure_apparmor() {
    # Install an AppArmor profile that allows bwrap to create user namespaces.
    # Required on Ubuntu 24.04+ where unprivileged userns is restricted by
    # AppArmor by default (kernel.apparmor_restrict_unprivileged_userns=1).

    if [[ "$(id -u)" -ne 0 ]]; then
        error "--configure-apparmor must be run as root"
        error "Usage: sudo scoder --configure-apparmor"
        exit 1
    fi

    if [[ ! -d /etc/apparmor.d ]]; then
        error "AppArmor does not appear to be installed (/etc/apparmor.d not found)"
        exit 1
    fi

    local bwrap_path
    bwrap_path="$(command -v bwrap 2>/dev/null || true)"
    if [[ -z "${bwrap_path}" ]]; then
        error "bwrap not found in PATH"
        exit 1
    fi
    # Resolve to real path in case of symlinks
    bwrap_path="$(realpath "${bwrap_path}")"

    if [[ -f "${APPARMOR_PROFILE_PATH}" ]]; then
        info "Existing profile found at ${APPARMOR_PROFILE_PATH}:"
        cat "${APPARMOR_PROFILE_PATH}"
        echo ""
    fi

    local profile
    profile="$(cat <<PROFILE_EOF
# AppArmor profile for bubblewrap (bwrap)
# Installed by scoder to allow unprivileged user namespace creation.
# This is required on Ubuntu 24.04+ where AppArmor restricts userns.
# Same approach used by Chrome, Firefox, Flatpak, etc.

abi <abi/4.0>,
include <tunables/global>

profile bwrap ${bwrap_path} flags=(unconfined) {
  userns,

  include if exists <local/bwrap>
}
PROFILE_EOF
)"

    echo "${profile}" > "${APPARMOR_PROFILE_PATH}"
    info "Wrote AppArmor profile to ${APPARMOR_PROFILE_PATH}"

    # Create local override directory (standard AppArmor convention)
    mkdir -p /etc/apparmor.d/local
    if [[ ! -f /etc/apparmor.d/local/bwrap ]]; then
        echo "# Site-specific overrides for bwrap" > /etc/apparmor.d/local/bwrap
    fi

    # Reload the profile
    if command -v apparmor_parser >/dev/null 2>&1; then
        if apparmor_parser -r "${APPARMOR_PROFILE_PATH}" 2>&1; then
            info "AppArmor profile loaded successfully"
        else
            error "Failed to load AppArmor profile"
            error "Try: sudo apparmor_parser -r ${APPARMOR_PROFILE_PATH}"
            exit 1
        fi
    else
        warning "apparmor_parser not found — profile written but not loaded"
        warning "Reload manually or reboot to activate"
    fi

    # Verify it works
    echo ""
    info "Verifying bwrap can create user namespaces..."
    local test_result
    if test_result=$(su -c "bwrap --bind / / /bin/echo SUCCESS" "${SUDO_USER:-nobody}" 2>&1) && [[ "${test_result}" == "SUCCESS" ]]; then
        info "Verification passed — bwrap works for unprivileged users"
    else
        warning "Verification inconclusive: ${test_result}"
        warning "Try running './tests/validate.sh' as your normal user"
    fi

    echo ""
    info "Done. You can now run scoder as a normal user."
}

# Check if bwrap is blocked by AppArmor and give actionable advice
check_bwrap_userns() {
    # Quick test: can bwrap create a namespace?
    local test_output
    test_output=$(bwrap --bind / / /bin/true 2>&1) && return 0

    # It failed — diagnose why
    if echo "${test_output}" | grep -q "setting up uid map"; then
        # Check if AppArmor userns restriction is the cause
        local restrict
        restrict=$(sysctl -n kernel.apparmor_restrict_unprivileged_userns 2>/dev/null || echo "0")
        if [[ "${restrict}" -eq 1 ]]; then
            if [[ -f "${APPARMOR_PROFILE_PATH}" ]]; then
                error "bwrap cannot create user namespaces"
                error "An AppArmor profile exists at ${APPARMOR_PROFILE_PATH} but may not be loaded"
                error "Try: sudo apparmor_parser -r ${APPARMOR_PROFILE_PATH}"
            else
                error "bwrap cannot create user namespaces"
                error "AppArmor is restricting unprivileged user namespaces on this system"
                error "Fix: sudo scoder --configure-apparmor"
            fi
            exit 1
        fi
    fi

    # Some other bwrap failure
    error "bwrap self-test failed: ${test_output}"
    exit 1
}

# ======== System dependencies ===========


install_dependencies() {

    if [[ "$(id -u)" -ne 0 ]]; then
        error "--install-dependencies must be run as root"
        error "Usage: sudo scoder --install-dependencies"
        exit 1
    fi

    apt install bubblewrap passt

}


# ====== Tool Presets ======
#
# Each preset defines:
#   config_binds() - function that appends to TOOL_BINDS and TOOL_DIRS arrays
#   validate() - function that checks prerequisites, returns 0/1
#   description - human-readable name

# ====== OpenCode =====

preset_opencode() {
    TOOL_DESCRIPTION="OpenCode"
}

preset_opencode_config_binds() {
    local real_home="${HOME}"
    local sand_home="${SCODER_HOME}"

    # Config: ~/.config/opencode/ (read-only)
    if [[ -d "${real_home}/.config/opencode" ]]; then
        TOOL_DIRS+=("${sand_home}/.config/opencode")
        TOOL_BINDS+=(--ro-bind "${real_home}/.config/opencode" "${sand_home}/.config/opencode")
    fi

    # Data: ~/.local/share/opencode/ (read-write for sessions, db, etc.)
    local data_dir="${real_home}/.local/share/opencode"
    mkdir -p "${data_dir}"
    TOOL_DIRS+=("${sand_home}/.local/share/opencode")
    TOOL_BINDS+=(--bind "${data_dir}" "${sand_home}/.local/share/opencode")

    # Cache: ~/.cache/opencode/ (read-write)
    local cache_dir="${real_home}/.cache/opencode"
    mkdir -p "${cache_dir}"
    TOOL_DIRS+=("${sand_home}/.cache/opencode")
    TOOL_BINDS+=(--bind "${cache_dir}" "${sand_home}/.cache/opencode")
}

preset_opencode_validate() {
    if ! command -v opencode >/dev/null 2>&1; then
        error "opencode not found in PATH"
        error "Install: https://opencode.ai"
        return 1
    fi
    return 0
}

