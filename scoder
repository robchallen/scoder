fi

# Git directory: the worktree's .git file points to GIT_DIR/worktrees/<name>
# which in turn references back. Both must be accessible at real paths.
# The worktree must be able to write to it to persist changes back to the branch
BWRAP_CMD+=(--bind "${GIT_DIR}" "${GIT_DIR}")

# Working directory
BWRAP_CMD+=(--chdir "${SCODER_PROJ_DIR}")

# Isolation + environment
