    if ! command -v node >/dev/null 2>&1; then
        error "node not found in PATH (required by Copilot CLI)"
        return 1
    fi
    return 0
}

# ====== Git Worktree Lifecycle ======

WORKTREE_DIR=""
WORKTREE_BRANCH=""
WORKTREE_BASE_COMMIT=""
GIT_DIR=""
PROJ_DIR=""
SOURCE_REPO_ROOT=""
SOURCE_BRANCH=""
SOURCE_HEAD=""
SOURCE_REF_LABEL=""
AGENTS_SNAPSHOT_DIR=""
AGENTS_MD_OVERLAY_FILE=""
SANDBOX_RESOLV_CONF_FILE=""

setup_agents_snapshot() {
    local agents_src="${HOME}/.agents"
    if [[ ! -d "${agents_src}" ]]; then
        return 0
    fi

    AGENTS_SNAPSHOT_DIR="$(mktemp -d /tmp/scoder-agents.XXXXXX)"
    if ! cp -aL "${agents_src}/." "${AGENTS_SNAPSHOT_DIR}/"; then
        error "Failed to snapshot ${agents_src}"
        error "scoder copies ~/.agents at startup so symlinked skills resolve in the sandbox"
        exit 1
    fi

    EXTRA_BINDS+=(--ro-bind "${AGENTS_SNAPSHOT_DIR}" "${SCODER_HOME}/.agents")
    info "Snapshotting ${agents_src} to ${AGENTS_SNAPSHOT_DIR}"
}

setup_sandbox_agents_md_overlay() {
    local agents_src="${WORKTREE_DIR_REAL}/AGENTS.md"
    if git -C "${WORKTREE_DIR_REAL}" ls-files --error-unmatch -- AGENTS.md >/dev/null 2>&1; then
        if ! git -C "${WORKTREE_DIR_REAL}" update-index --skip-worktree -- AGENTS.md; then
            error "Failed to mark AGENTS.md skip-worktree in ${WORKTREE_DIR_REAL}"
            exit 1
        fi
    fi

    AGENTS_MD_OVERLAY_FILE="$(mktemp /tmp/scoder-agents-md.XXXXXX)"

    if [[ -f "${agents_src}" ]]; then
        if ! cat "${agents_src}" > "${AGENTS_MD_OVERLAY_FILE}"; then
            error "Failed to snapshot ${agents_src}"
            exit 1
        fi
        printf "\n" >> "${AGENTS_MD_OVERLAY_FILE}"
    fi

    if ! cat >> "${AGENTS_MD_OVERLAY_FILE}" <<'EOF'
## scoder sandbox

This section is injected by scoder inside the sandbox and is not part of the repository.

- You are running inside a scoder sandbox.
- `/home/scoder` is an ephemeral sandbox home. Other paths in your context may be stale if they refer to the host's home path. Always use paths relative to $HOME.
- This checkout is an isolated git worktree managed by scoder.
- Commit after all changes otherwise your edits will be lost.
- Locally hosted HTTP MCP servers may not be available.
- You cannot edit files like `AGENTS.md` or `.agents/*` or other configuration files, so do not try.
- Read the `working-in-a-scoder-sandbox` skill: `npx skills add https://github.com/robchallen/scoder/tree/main/skills/working-in-a-scoder-sandbox`
EOF
    then
        error "Failed to write sandbox AGENTS.md overlay"
        exit 1
    fi

    OVERLAY_BINDS+=(--ro-bind "${AGENTS_MD_OVERLAY_FILE}" "${SCODER_PROJ_DIR}/AGENTS.md")
    info "Overlaying sandbox AGENTS.md"
}

clear_worktree_agents_md_skip_worktree() {
    local worktree_dir="$1"

    if ! git -C "${worktree_dir}" ls-files --error-unmatch -- AGENTS.md >/dev/null 2>&1; then
        return 0
    fi

    if ! git -C "${worktree_dir}" update-index --no-skip-worktree -- AGENTS.md; then
        error "Failed to clear AGENTS.md skip-worktree in ${worktree_dir}"
        exit 1
    fi
}

refresh_source_checkout_metadata() {
    local repo_dir="$1"

    SOURCE_HEAD="$(git -C "${repo_dir}" rev-parse HEAD)"
    SOURCE_BRANCH="$(git -C "${repo_dir}" symbolic-ref --quiet --short HEAD 2>/dev/null || true)"
    if [[ -n "${SOURCE_BRANCH}" ]]; then
        SOURCE_REF_LABEL="${SOURCE_BRANCH}@${SOURCE_HEAD:0:12}"
    else
        SOURCE_REF_LABEL="HEAD@${SOURCE_HEAD:0:12}"
    fi
}

prompt_commit_source_checkout_changes() {
    local repo_dir="$1"

    if [[ -z "$(git -C "${repo_dir}" status --porcelain 2>/dev/null)" ]]; then
        return 0
    fi

    warning "You have uncommitted changes in your working tree"
    printf "%s: Commit local changes before starting scoder? [y/N] " "${PROGRAM_NAME}" >&2

    local reply=""
    if ! IFS= read -r reply; then
        echo "" >&2
        error "You must commit (or stash) changes before running scoder"
        exit 1
    fi

    case "${reply}" in
    y | Y | yes | YES | Yes)
        local commit_message=""
        while true; do
            printf "%s: Commit message: " "${PROGRAM_NAME}" >&2
            if ! IFS= read -r commit_message; then
                echo "" >&2
                error "No commit message received"
                exit 1
            fi

            if [[ -n "${commit_message}" ]]; then
                break
            fi

            warning "Commit message cannot be empty"
        done

        if ! git -C "${repo_dir}" add -A; then
            error "Failed to stage local changes"
            exit 1
        fi

        local commit_output
        if ! commit_output=$(git -C "${repo_dir}" commit -m "${commit_message}" 2>&1); then
            error "Failed to commit local changes"
            error "${commit_output}"
            exit 1
        fi
        if [[ -n "${commit_output}" ]]; then
            echo "${commit_output}" >&2
        fi

        refresh_source_checkout_metadata "${repo_dir}"
        info "Committed local changes as ${SOURCE_REF_LABEL}"
        ;;
    *)
        error "You must commit (or stash) changes before running scoder"
        exit 1
        ;;
    esac
}

setup_sandbox_resolv_conf() {
    local resolv_src="/etc/resolv.conf"

    if grep -qE '^nameserver[[:space:]]+(127\.|::1)' "${resolv_src}" \
        && [[ -f "/run/systemd/resolve/resolv.conf" ]]; then
        resolv_src="/run/systemd/resolve/resolv.conf"
    fi

    SANDBOX_RESOLV_CONF_FILE="$(mktemp /tmp/scoder-resolv.conf.XXXXXX)"
    if ! cp "${resolv_src}" "${SANDBOX_RESOLV_CONF_FILE}"; then
        error "Failed to snapshot ${resolv_src}"
        exit 1
    fi

    EXTRA_BINDS+=(--ro-bind "${SANDBOX_RESOLV_CONF_FILE}" "/etc/resolv.conf")
}

append_unique_path() {
    local -n target_array="$1"
    local value="$2"
    local existing=""

    for existing in "${target_array[@]}"; do
        if [[ "${existing}" = "${value}" ]]; then
            return 0
        fi
    done

    target_array+=("${value}")
}

paths_overlap() {
    local left="${1%/}"
    local right="${2%/}"

    [[ "${left}" = "${right}" || "${left}" == "${right}"/* || "${right}" == "${left}"/* ]]
}

prompt_sync_existing_worktree() {
    local worktree_dir="$1"

    if git -C "${worktree_dir}" merge-base --is-ancestor "${SOURCE_HEAD}" HEAD >/dev/null 2>&1; then
        return 0
    fi

    local source_ahead_count
    source_ahead_count=$(git -C "${worktree_dir}" rev-list --count "HEAD..${SOURCE_HEAD}" 2>/dev/null || echo "0")
    if [[ "${source_ahead_count}" -eq 0 ]]; then
        return 0
    fi

    if [[ -n "$(git -C "${worktree_dir}" status --porcelain 2>/dev/null)" ]]; then
        warning "Existing scoder worktree is behind ${SOURCE_REF_LABEL} but has uncommitted changes"
        warning "Resolve or commit those changes in ${worktree_dir} before syncing it forward"
        return 0
    fi

    warning "Existing scoder worktree is behind ${SOURCE_REF_LABEL} by ${source_ahead_count} commit(s)"
    printf "%s: Merge %s into %s now? [y/N] " "${PROGRAM_NAME}" "${SOURCE_REF_LABEL}" "${WORKTREE_BRANCH}" >&2

    local reply=""
    if ! IFS= read -r reply; then
        echo "" >&2
        warning "No response received; continuing without syncing the worktree"
        return 0
    fi

    case "${reply}" in
    y | Y | yes | YES | Yes)
        if [[ "${DRY_RUN}" -eq 1 ]]; then
            info "Dry run — would merge ${SOURCE_REF_LABEL} into ${WORKTREE_BRANCH}"
            return 0
        fi

        clear_worktree_agents_md_skip_worktree "${worktree_dir}"

        local merge_output
        if ! merge_output=$(git -C "${worktree_dir}" merge --no-edit "${SOURCE_HEAD}" 2>&1); then
            error "Failed to merge ${SOURCE_REF_LABEL} into ${WORKTREE_BRANCH}"
            error "${merge_output}"
            exit 1
        fi
        info "Merged ${SOURCE_REF_LABEL} into ${WORKTREE_BRANCH}"
        ;;
    *)
        info "Continuing without syncing ${WORKTREE_BRANCH}"
        ;;
    esac
}

show_post_session_commands() {
    info "To review:  git log ${WORKTREE_BRANCH}"
    info "To merge:   git merge ${WORKTREE_BRANCH}"
    info "To rebase:  git rebase ${WORKTREE_BRANCH}"
    if [[ -n "${WORKTREE_BASE_COMMIT}" ]]; then
        info "View diff:  git diff ${WORKTREE_BASE_COMMIT}..${WORKTREE_BRANCH}"
    else
        info "View diff:  git diff ${WORKTREE_BRANCH}"
    fi
    info "To discard: git worktree remove ${WORKTREE_DIR} && git branch -D ${WORKTREE_BRANCH}"
}

detect_default_llm_port() {
    if [[ -n "${LLM_PORT}" ]]; then
        return 0
    fi

    local response=""
    local line=""

    if ! exec 3<>"/dev/tcp/127.0.0.1/11434" 2>/dev/null; then
        return 0
    fi

    printf 'GET /v1/models HTTP/1.1\r\nHost: 127.0.0.1\r\nConnection: close\r\n\r\n' >&3
    while IFS= read -r -t 1 line <&3; do
        response="${response}${line}"$'\n'
    done
    exec 3>&-
    exec 3<&-

    if [[ "${response}" == *"HTTP/"*" 200 "* ]]; then
        LLM_PORT="11434"
        info "Auto-detected local OpenAI-compatible API on 127.0.0.1:11434"
    fi
}

run_post_session_menu() {
    if [[ ! -t 0 || ! -t 1 || ! -t 2 ]]; then
        show_post_session_commands
        return 0
    fi

    local diff_ref="HEAD...${WORKTREE_BRANCH}"
    if [[ -n "${WORKTREE_BASE_COMMIT}" ]]; then
        diff_ref="${WORKTREE_BASE_COMMIT}..${WORKTREE_BRANCH}"
    fi

    local diff_ref_2="${WORKTREE_BRANCH}"

    while true; do
        echo "" >&2
        echo -e "${BLUE}${PROGRAM_NAME}: Post-session actions:${NC}" >&2
        echo -e "${BLUE}${PROGRAM_NAME}:   1. Review last 20 branch logs${NC}" >&2
        echo -e "${BLUE}${PROGRAM_NAME}:   2. Merge ${WORKTREE_BRANCH} into current branch${NC}" >&2
        echo -e "${BLUE}${PROGRAM_NAME}:   3. Rebase current branch onto ${WORKTREE_BRANCH}${NC}" >&2
        echo -e "${BLUE}${PROGRAM_NAME}:   4. View changes made by agent${NC}" >&2
        echo -e "${BLUE}${PROGRAM_NAME}:   5. View diff against current branch${NC}" >&2
        echo -e "${BLUE}${PROGRAM_NAME}:   6. Discard worktree and delete branch${NC}" >&2
        echo -e "${BLUE}${PROGRAM_NAME}:   q. Quit${NC}" >&2
        printf "%s: Choose an action [1-6/q]: " "${PROGRAM_NAME}" >&2

        local reply=""
        if ! IFS= read -r reply; then
            echo "" >&2
            return 0
        fi

        local action_output=""
        case "${reply}" in
        1)
            git -C "${SOURCE_REPO_ROOT}" --no-pager log --oneline --max-count=20 "${WORKTREE_BRANCH}"
            ;;
        2)
            if ! action_output=$(git -C "${SOURCE_REPO_ROOT}" merge "${WORKTREE_BRANCH}" 2>&1); then
                error "Failed to merge ${WORKTREE_BRANCH}"
                error "${action_output}"
            elif [[ -n "${action_output}" ]]; then
                echo "${action_output}" >&2
            fi
            ;;
        3)
            if ! action_output=$(git -C "${SOURCE_REPO_ROOT}" rebase "${WORKTREE_BRANCH}" 2>&1); then
                error "Failed to rebase onto ${WORKTREE_BRANCH}"
                error "${action_output}"
            elif [[ -n "${action_output}" ]]; then
                echo "${action_output}" >&2
            fi
            ;;
        4)
            git -C "${SOURCE_REPO_ROOT}" --no-pager diff "${diff_ref}"
            ;;
        5)
            git -C "${SOURCE_REPO_ROOT}" --no-pager diff "${diff_ref_2}"
            ;;
        6)
            if ! action_output=$(git -C "${SOURCE_REPO_ROOT}" worktree remove "${WORKTREE_DIR}" 2>&1); then
                error "Failed to remove worktree ${WORKTREE_DIR}"
                error "${action_output}"
                continue
            fi
            if ! action_output=$(git -C "${SOURCE_REPO_ROOT}" branch -D "${WORKTREE_BRANCH}" 2>&1); then
                error "Removed worktree but failed to delete branch ${WORKTREE_BRANCH}"
                error "${action_output}"
                return 1
            fi
            if [[ -n "${action_output}" ]]; then
                echo "${action_output}" >&2
            fi
            return 0
            ;;
        q | Q | quit | QUIT | Quit)
            return 0
            ;;
        *)
            warning "Unknown choice: ${reply}"
            ;;
        esac
    done
}

add_scoder_dir_tree() {
    local sandbox_path="$1"

    if [[ "${sandbox_path}" = "${SCODER_HOME}" ]]; then
        return 0
    fi

    local relative_path="${sandbox_path#"${SCODER_HOME}/"}"
    local current_path="${SCODER_HOME}"
    local path_part=""
    local -a path_parts=()

    IFS='/' read -r -a path_parts <<< "${relative_path}"
    for path_part in "${path_parts[@]}"; do
        current_path="${current_path}/${path_part}"
        append_unique_path TOOL_DIRS "${current_path}"
    done
}

register_agentreadonly_home_bind() {
    local home_path_expr="$1"
    local home_real
    home_real="$(realpath "${HOME}")"

    local relative_path="${home_path_expr#\$HOME/}"
    local source_path="${HOME}/${relative_path}"
    local source_real
    source_real="$(realpath "${source_path}" 2>/dev/null || true)"

    if [[ -z "${source_real}" || ! -d "${source_real}" ]]; then
        error ".agentreadonly HOME bind must reference an existing directory: ${home_path_expr}"
        exit 1
    fi

    if [[ "${source_real}" != "${home_real}" && "${source_real}" != "${home_real}/"* ]]; then
        error ".agentreadonly HOME bind escapes HOME: ${home_path_expr}"
        exit 1
    fi

    local sandbox_dest="${SCODER_HOME}/${relative_path}"
    local reserved_path=""
    local -a reserved_paths=(
        "${SCODER_PROJ_DIR}"
        "${SCODER_HOME}/.agents"
        "${SCODER_HOME}/.cache"
        "${SCODER_HOME}/.cargo"
        "${SCODER_HOME}/.claude"
        "${SCODER_HOME}/.config"
        "${SCODER_HOME}/.copilot"
        "${SCODER_HOME}/.gitconfig"
        "${SCODER_HOME}/.local"
        "${SCODER_HOME}/.m2"
        "${SCODER_HOME}/.npmrc"
        "${SCODER_HOME}/.pypirc"
        "${SCODER_HOME}/.Rprofile"
        "${SCODER_HOME}/.rustup"
        "${SCODER_HOME}/R"
    )

    for reserved_path in "${reserved_paths[@]}"; do
        if paths_overlap "${sandbox_dest}" "${reserved_path}"; then
            error ".agentreadonly HOME bind overlaps reserved sandbox path: ${home_path_expr}"
            exit 1
        fi
    done

    add_scoder_dir_tree "${sandbox_dest}"
    EXTRA_BINDS+=(--ro-bind "${source_real}" "${sandbox_dest}")
    info "Binding ${home_path_expr} to ${sandbox_dest} (read-only)"
}

setup_git_worktree() {
    # Verify we are in a git repo
    if ! git rev-parse --git-dir >/dev/null 2>&1; then
        error "not inside a git repository"
        error "scoder must be run from within a git repo"
        exit 1
    fi

    GIT_DIR="$(git rev-parse --path-format=absolute --git-common-dir)"
    local repo_root
    repo_root="$(git rev-parse --show-toplevel)"
    local repo_root_real
    repo_root_real="$(realpath "${repo_root}")"
    SOURCE_REPO_ROOT="${repo_root_real}"
    refresh_source_checkout_metadata "${SOURCE_REPO_ROOT}"
    local proj_name
    proj_name="$(basename "${repo_root}")"

    # Compute a safe relative path for use under /tmp/scoder and SCODER_HOME.
    # Repos under HOME use the shorter HOME-relative path (e.g. projects/foo).
    # Repos elsewhere (e.g. /tmp/...) strip the leading / to avoid path traversal
    # (../../ components) that would make WORKTREE_DIR collide with the real repo.
    if [[ "${repo_root}" == "${HOME}/"* ]]; then
        PROJ_DIR="${repo_root#"${HOME}/"}"
    else
        PROJ_DIR="${repo_root#/}"
    fi

    WORKTREE_BRANCH="scoder/${proj_name}"
    local worktree_list
    worktree_list="$(git worktree list --porcelain 2>/dev/null || true)"

    # Reuse the current checkout when scoder is launched from its own worktree.
    # This avoids blocking on the worktree's in-progress changes.
    if [[ "${SOURCE_BRANCH}" = "${WORKTREE_BRANCH}" ]]; then
        local current_worktree_dir
        current_worktree_dir="$(echo "${worktree_list}" | grep -B2 "^branch refs/heads/${WORKTREE_BRANCH}$" | head -1 | cut -d' ' -f2)"
        if [[ -n "${current_worktree_dir}" && "$(realpath "${current_worktree_dir}")" = "${repo_root_real}" ]]; then
            WORKTREE_DIR="${repo_root_real}"
            WORKTREE_BASE_COMMIT="$(git rev-parse HEAD)"
            info "Already in scoder worktree: ${WORKTREE_DIR}"
            return 0
        fi
    fi

    prompt_commit_source_checkout_changes "${SOURCE_REPO_ROOT}"

    if ! git branch --list "${WORKTREE_BRANCH}" | grep . >/dev/null; then
        # There is no branch named scoder/${proj_name}

        WORKTREE_DIR="/tmp/scoder/${PROJ_DIR}"
        info "Creating worktree branch: ${WORKTREE_BRANCH}"
        info "Worktree path: ${WORKTREE_DIR}"

        local wt_output
        if ! wt_output=$(git worktree add -b "${WORKTREE_BRANCH}" "${WORKTREE_DIR}" HEAD 2>&1); then
            error "Failed to create git worktree"
            error "${wt_output}"
            exit 1
        fi

        info "Worktree created successfully"

        worktree_list="$(git worktree list --porcelain 2>/dev/null || true)"
    fi

    if echo "${worktree_list}" | grep "^branch refs/heads/${WORKTREE_BRANCH}$" >/dev/null; then

        # It is a worktree: read the current directory associated with it.
        WORKTREE_DIR="$(echo "${worktree_list}" | grep -B2 "^branch refs/heads/${WORKTREE_BRANCH}$" | head -1 | cut -d' ' -f2)"

    fi

    if [[ -z "${WORKTREE_DIR}" ]]; then
        error "Branch ${WORKTREE_BRANCH} exists but is not a git worktree - you'll need to manually review it."
        info "to review:   git diff ${WORKTREE_BRANCH}"
        info "to delete:   git branch -D ${WORKTREE_BRANCH}"
        exit 1
    fi

    # If a stale worktree with no files are listed then
    if echo "${worktree_list}" | grep -A1 "^branch refs/heads/${WORKTREE_BRANCH}$" | tail -1 | grep "prunable" >/dev/null; then
        # pruneable
        git worktree prune
        error "Branch ${WORKTREE_BRANCH} exists but the worktree has gone - you need to manually review it."
        info "to review:   git diff ${WORKTREE_BRANCH}"
        info "to delete:   git branch -D ${WORKTREE_BRANCH}"
        exit 1
    fi

    prompt_sync_existing_worktree "${WORKTREE_DIR}"


    # Record the base commit so we can compare against it later in the summary
    WORKTREE_BASE_COMMIT="$(git rev-parse HEAD)"

}

cleanup_worktree_summary() {
    # Called on exit — print summary of what happened on the branch
    # Disable errexit so cleanup always completes
    set +e
    local exit_code=$?

    # reset

    if [[ -n "${WORKTREE_DIR}" && -d "${WORKTREE_DIR}" ]]; then
        info "${TOOL_DESCRIPTION} session complete."

        git -C "${WORKTREE_DIR}" add -A
        git -C "${WORKTREE_DIR}" commit -m "Committing session by ${TOOL_DESCRIPTION}."

        echo "" >&2
        info_blue "====== Session Summary ======"

        info_blue "Branch: ${WORKTREE_BRANCH}"
        info_blue "Worktree: ${WORKTREE_DIR}"

        # Count commits on the branch since it was created
        local commit_count=0
        if [[ -n "${WORKTREE_BASE_COMMIT}" ]]; then
            commit_count=$(git -C "${WORKTREE_DIR}" rev-list "${WORKTREE_BASE_COMMIT}..HEAD" --count 2>/dev/null || echo "0")
        fi

        if [[ "${commit_count}" -gt 0 ]]; then
            info_blue "New commits: ${commit_count}"
            # Show overall diff stat from base to branch tip
            local stat_output
            stat_output=$(git -C "${WORKTREE_DIR}" diff --stat "${WORKTREE_BASE_COMMIT}" HEAD 2>/dev/null || true)
            if [[ -n "${stat_output}" ]]; then
                info_blue "Changes since base:"
                echo "${stat_output}" | while read -r line; do
                    info_blue "  ${line}"
                done
            fi
        fi

        if [[ "${commit_count}" -eq 0 ]]; then
            info_blue "No changes were made"
        fi

        run_post_session_menu
    fi

    if [[ -n "${AGENTS_SNAPSHOT_DIR}" && -d "${AGENTS_SNAPSHOT_DIR}" ]]; then
        rm -rf "${AGENTS_SNAPSHOT_DIR}"
    fi

    if [[ -n "${AGENTS_MD_OVERLAY_FILE}" && -e "${AGENTS_MD_OVERLAY_FILE}" ]]; then
        rm -f "${AGENTS_MD_OVERLAY_FILE}"
    fi

    if [[ -n "${SANDBOX_RESOLV_CONF_FILE}" && -e "${SANDBOX_RESOLV_CONF_FILE}" ]]; then
        rm -f "${SANDBOX_RESOLV_CONF_FILE}"
    fi

    return "${exit_code}"
}

# ====== Defaults ======

QUIET=0
CONFIGURE_APPARMOR=0
INSTALL_DEPENDENCIES=0
DRY_RUN=0
LLM_PORT=""

TOOL_NAME=""
TOOL_ARGS=()

# ====== Option Parsing ======
# Parse scoder options until we hit a non-option (the tool name)

while [[ $# -gt 0 ]]; do
    case "$1" in
    -h | --help)
        usage
        exit 0
        ;;
    -V | --version)
        version
        exit 0
        ;;
    -q | --quiet)
        QUIET=1
        shift
        ;;
    --llm-port)
        if [[ $# -lt 2 ]]; then
            error "--llm-port requires a port number"
            exit 1
        fi
        LLM_PORT="$2"
        shift 2
        ;;
    --llm-port=*)
        LLM_PORT="${1#--llm-port=}"
        shift
        ;;
    --configure-apparmor)
        CONFIGURE_APPARMOR=1
        shift
        ;;
    --install-dependencies)
        INSTALL_DEPENDENCIES=1
        shift
        ;;
    --dry-run)
        DRY_RUN=1
        shift
        ;;
    -*)
        error "unknown option: $1"
        echo "Try '${PROGRAM_NAME} --help' for more information." >&2
        exit 1
        ;;
    *)
        # First non-option is the tool name; rest are tool args
        TOOL_NAME="$1"
        shift
        TOOL_ARGS=("$@")
        break
        ;;
    esac
done

# ====== Validation (early) ======

if [[ "${INSTALL_DEPENDENCIES}" -eq 1 ]]; then
    install_dependencies
    exit $?
fi

if ! command -v bwrap >/dev/null 2>&1; then
    error "bubblewrap (bwrap) not found in PATH"
    error "run sudo scoder --install-dependencies"
    exit 1
fi

if ! command -v pasta >/dev/null 2>&1; then
    error "pasta not found in PATH"
    error "run sudo scoder --install-dependencies"
    exit 1
fi

detect_default_llm_port

if [[ -n "${LLM_PORT}" ]]; then
    # Split by comma and validate each port
    IFS=',' read -ra PORTS <<< "${LLM_PORT}"
    for port in "${PORTS[@]}"; do
        if ! [[ "${port}" =~ ^[0-9]+$ ]] || [[ "${port}" -lt 1 || "${port}" -gt 65535 ]]; then
            error "--llm-port must be a comma-separated list of integers between 1 and 65535"
            exit 1
        fi
    done
fi

# ====== AppArmor setup (early exit) ======

if [[ "${CONFIGURE_APPARMOR}" -eq 1 ]]; then
    configure_apparmor
    exit $?
fi

# ====== Check bwrap can actually work ======

check_bwrap_userns

# ====== Tool name required ======

if [[ -z "${TOOL_NAME}" ]]; then
    error "no tool specified"
    echo "Usage: ${PROGRAM_NAME} [options] <tool> [tool-args...]" >&2
    echo "Try '${PROGRAM_NAME} --help' for more information." >&2
    exit 1
fi

# ====== Apply tool preset ======

TOOL_DESCRIPTION=""
TOOL_BINDS=()
TOOL_DIRS=()
HAS_PRESET=0

case "${TOOL_NAME}" in
opencode)
    HAS_PRESET=1
    preset_opencode
    ;;
claude)
    HAS_PRESET=1
    preset_claude
    ;;
copilot)
    HAS_PRESET=1
    preset_copilot
    ;;
pi)
    HAS_PRESET=1
    preset_pi
    ;;
*)
    # No preset — generic sandbox
    TOOL_DESCRIPTION="${TOOL_NAME}"
    ;;
esac

# Resolve tool binary
TOOL_BIN=""
if command -v "${TOOL_NAME}" >/dev/null 2>&1; then
    TOOL_BIN="$(command -v "${TOOL_NAME}")"
else
    error "${TOOL_NAME} not found in PATH"
    exit 1
fi

# Run preset validation if available
if [[ "${HAS_PRESET}" -eq 1 ]]; then
    if ! "preset_${TOOL_NAME}_validate"; then
        exit 1
    fi
fi

# ====== Git worktree setup ======

setup_git_worktree

# Register cleanup on exit (and common signals for reliable cleanup)
trap cleanup_worktree_summary EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

# ====== Build tool-specific config binds ======

if [[ "${HAS_PRESET}" -eq 1 ]]; then
    "preset_${TOOL_NAME}_config_binds"
fi

# ====== Resolve paths ======

# GIT_DIR was already set in setup_git_worktree() — reuse it
WORKTREE_DIR_REAL="$(realpath "${WORKTREE_DIR}")"
SCODER_PROJ_DIR="$SCODER_HOME/$PROJ_DIR"

# ====== Build sandbox PATH ======

SANDBOX_PATH="/usr/local/bin:/usr/local/sbin:/usr/bin:/usr/sbin:/bin:/sbin"
EXTRA_BINDS=()
OVERLAY_BINDS=()
setup_sandbox_agents_md_overlay
setup_sandbox_resolv_conf

# Host tools

if [[ -d "${HOME}/.local/bin" ]]; then
    EXTRA_BINDS+=(--ro-bind "${HOME}/.local/bin" "${SCODER_HOME}/.local/bin")
    SANDBOX_PATH="${SANDBOX_PATH}:${SCODER_HOME}/.local/bin"
fi

# Git config / agent skills standard location:
[[ -e "${HOME}/.gitconfig" ]] && EXTRA_BINDS+=(--ro-bind "${HOME}/.gitconfig" "${SCODER_HOME}/.gitconfig")
setup_agents_snapshot

# R
[[ -d "${HOME}/R" ]] && EXTRA_BINDS+=(--ro-bind "${HOME}/R" "${SCODER_HOME}/R")
[[ -e "${HOME}/.Rprofile" ]] && EXTRA_BINDS+=(--ro-bind "${HOME}/.Rprofile" "${SCODER_HOME}/.Rprofile")

# Java
[[ -d "${HOME}/.m2" ]] && EXTRA_BINDS+=(--ro-bind "${HOME}/.m2" "${SCODER_HOME}/.m2")

# Mise
[[ -d "${HOME}/.local/share/mise" ]] && EXTRA_BINDS+=(--ro-bind "${HOME}/.local/share/mise" "${SCODER_HOME}/.local/share/mise")
[[ -d "${HOME}/.config/mise" ]] && EXTRA_BINDS+=(--ro-bind "${HOME}/.config/mise" "${SCODER_HOME}/.config/mise")
[[ -d "${HOME}/.local/share/mise/shims" ]] && SANDBOX_PATH="${SANDBOX_PATH}:${SCODER_HOME}/.local/share/mise/shims"

# Rust
[[ -d "${HOME}/.rustup" ]] && EXTRA_BINDS+=(--ro-bind "${HOME}/.rustup" "${SCODER_HOME}/.rustup")
if [[ -d "${HOME}/.cargo/bin" ]]; then
    EXTRA_BINDS+=(--ro-bind "${HOME}/.cargo/bin" "${SCODER_HOME}/.cargo/bin")
    SANDBOX_PATH="${SANDBOX_PATH}:${SCODER_HOME}/.cargo/bin"
fi

# Config files
[[ -f "${HOME}/.npmrc" ]] && EXTRA_BINDS+=(--ro-bind "${HOME}/.npmrc" "${SCODER_HOME}/.npmrc")
[[ -f "${HOME}/.pypirc" ]] && EXTRA_BINDS+=(--ro-bind "${HOME}/.pypirc" "${SCODER_HOME}/.pypirc")


# Worktree-local tool paths
if [[ -d "${WORKTREE_DIR_REAL}/.venv/bin" ]]; then
    SANDBOX_PATH="${SCODER_PROJ_DIR}/.venv/bin:${SANDBOX_PATH}"
fi
if [[ -d "${WORKTREE_DIR_REAL}/node_modules/.bin" ]]; then
    SANDBOX_PATH="${SCODER_PROJ_DIR}/node_modules/.bin:${SANDBOX_PATH}"
fi
if [[ -d "${WORKTREE_DIR_REAL}/bin" && -f "${WORKTREE_DIR_REAL}/go.mod" ]]; then
    SANDBOX_PATH="${SCODER_PROJ_DIR}/bin:${SANDBOX_PATH}"
fi

# ====== Infrastructure Protection ======

# Defaults:
PROTECTED=(".github/" ".claude/" "opencode.json" ".gitignore" "package-lock.json" "poetry.lock" "Cargo.lock" "pnpm-lock.yaml" "yarn.lock" "mise.toml")
if [[ -e "${WORKTREE_DIR_REAL}/.agentreadonly" ]]; then
    PROTECTED=()
    while IFS= read -r line; do
        if [[ "${line}" =~ ^[[:space:]]*(#|$) ]]; then
            continue
        fi

        if [[ "${line}" == \$HOME/* ]]; then
            register_agentreadonly_home_bind "${line}"
            continue
        fi

        local_matches=()
        readarray -t local_matches < <(
            pattern="${line%/}"
            (cd "${WORKTREE_DIR_REAL}" && eval "find \"$pattern\" -maxdepth 100 -prune 2>/dev/null") \
                | sed 's|^\./||' | sort -u
        )

        for protected_path in "${local_matches[@]}"; do
            append_unique_path PROTECTED "${protected_path}"
        done
    done < "${WORKTREE_DIR_REAL}/.agentreadonly"
else
    printf "%s\n" "${PROTECTED[@]}" > "${WORKTREE_DIR_REAL}/.agentreadonly"
fi

SAFE_BINDS=()
SAFE_BINDS+=(--ro-bind "${WORKTREE_DIR_REAL}/.agentreadonly" "${SCODER_PROJ_DIR}/.agentreadonly")

# 3. Apply the binds
for path in "${PROTECTED[@]}"; do
    # Skip empty lines if any
    path="${path%/}"
    [[ -z "$path" ]] && continue

    src="${WORKTREE_DIR_REAL}/${path}"
    dest="${SCODER_PROJ_DIR}/${path}"

    if [[ -e "$src" ]]; then
        SAFE_BINDS+=(--ro-bind "$src" "$dest")
        info "Protecting ${path} (read-only)"
    fi
done

# ====== Build bwrap command ======

BWRAP_CMD=(
    bwrap
    # System mounts (read-only)
    --ro-bind /usr /usr
    --ro-bind /bin /bin
    --ro-bind /lib /lib
    --unshare-user
    --uid "$(id -u)"
    --gid "$(id -g)"
)

[[ -d /lib64 ]] && BWRAP_CMD+=(--ro-bind /lib64 /lib64)
[[ -d /sbin && ! -L /sbin ]] && BWRAP_CMD+=(--ro-bind /sbin /sbin)
[[ -d /sys ]] && BWRAP_CMD+=(--ro-bind /sys /sys)
[[ -d /run ]] && BWRAP_CMD+=(--ro-bind /run /run)

BWRAP_CMD+=(--ro-bind /etc /etc)

# Device access
BWRAP_CMD+=(
    --dev-bind /dev /dev
    --tmpfs /dev/shm
)

BWRAP_CMD+=(
    --proc /proc
    --tmpfs /tmp

    # Ephemeral HOME
    --tmpfs /home
    --dir "${SCODER_HOME}"
    --dir "${SCODER_HOME}/.local"
    --dir "${SCODER_HOME}/.local/share"
    --dir "${SCODER_HOME}/.config"
    --dir "${SCODER_HOME}/.cache"
    --dir "${SCODER_PROJ_DIR}"
)

# Create any extra dirs needed by tool presets
for d in "${TOOL_DIRS[@]}"; do
    BWRAP_CMD+=(--dir "${d}")
done

# Tool-specific config binds
if [[ ${#TOOL_BINDS[@]} -gt 0 ]]; then
    BWRAP_CMD+=("${TOOL_BINDS[@]}")
fi

# Host tools
if [[ ${#EXTRA_BINDS[@]} -gt 0 ]]; then
    BWRAP_CMD+=("${EXTRA_BINDS[@]}")
