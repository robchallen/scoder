# Worktree directory (at its real path)
BWRAP_CMD+=(--bind "${WORKTREE_DIR_REAL}" "${SCODER_PROJ_DIR}")

# Worktree overlays (must come AFTER the worktree bind to overlay)
if [[ ${#OVERLAY_BINDS[@]} -gt 0 ]]; then
